---
title: Leffic — Containers (C2)
config:
  themeCSS: ".flowchartTitleText, .titleText { font-size: 28px; font-weight: 600; }"
  layout: elk
  theme: neutral
---
flowchart LR
    learner["«person»<br/><b>Learner</b><br/>Imports material and reviews it"]

    subgraph leffic["Leffic"]
        ui["«container»<br/><b>Web app</b><br/>SolidJS / TypeScript, Vite, served by nginx<br/>Folder tree, import dialog, flashcard and test<br/>review, note reader, settings, chatbot panel"]

        gateway["«container»<br/><b>API gateway</b><br/>nginx with njs<br/>One public port; verifies the JWT and applies<br/>CORS before anything reaches a service"]

        userService["«container»<br/><b>User service</b><br/>FastAPI / Python<br/>The only identity authority: sign-up, login,<br/>refresh, account settings and sealed AI keys"]

        subgraph contentCodebase["Content service — one codebase, three deployables"]
            contentService["«container»<br/><b>Content API</b><br/>FastAPI / SQLAlchemy<br/>System of record for folders, decks, cards,<br/>tests and notes; owns study-unit generation,<br/>serves due counts and the chatbot"]

            worker["«container»<br/><b>Generation worker</b><br/>Celery / Python, same image<br/>Runs the three generation tasks that live in<br/>this service and writes their results itself"]

            userEvents["«container»<br/><b>User events consumer</b><br/>pika / Python, same image<br/>On user.deleted, removes that learner's folders<br/>and their uploaded documents"]
        end

        fileService["«container»<br/><b>File processor</b><br/>FastAPI / Python<br/>Uploads, text extraction, LibreOffice to PDF;<br/>enqueues generation by task name"]

        scheduler["«container»<br/><b>Scheduler service</b><br/>FastAPI / py-fsrs<br/>Computes the next review date and the<br/>per-rating interval labels"]

        userDb[("«container»<br/><b>User database</b><br/>PostgreSQL<br/>Accounts, password hashes and sealed keys")]

        contentDb[("«container»<br/><b>Content database</b><br/>PostgreSQL<br/>Folders, study units, review history<br/>and test sessions")]

        schedulerDb[("«container»<br/><b>Scheduler store</b><br/>MongoDB<br/>Per-user FSRS parameters")]

        queue[("«container»<br/><b>Task queue</b><br/>Redis<br/>Celery broker and result backend")]

        events[("«container»<br/><b>Event broker</b><br/>RabbitMQ<br/>Durable topic exchange for domain events<br/>between services")]

        fileVolume[("«container»<br/><b>File store</b><br/>Shared Docker volume<br/>Uploaded documents, read by both the file<br/>processor and the content service")]
    end

    openai["«external system»<br/><b>OpenAI Platform</b><br/>Study-unit generation and chatbot replies"]

    sources["«external system»<br/><b>YouTube and web pages</b><br/>Transcripts and article text for a pasted link"]

    learner -->|"Uses [HTTPS]"| ui
    ui -->|"Calls every API through one origin [HTTPS/JSON]"| gateway
    gateway -->|"Signs up, logs in, refreshes the token, changes the account [HTTP/JSON]"| userService
    gateway -->|"Reads folders and study units, records reviews, asks the chatbot [HTTP/JSON]"| contentService
    gateway -->|"Uploads files, extracts the source text, starts a generation [HTTP/JSON]"| fileService
    gateway -->|"Asks for the per-rating interval labels [HTTP/JSON]"| scheduler

    userService -->|"Stores accounts in [SQLAlchemy]"| userDb
    userService -->|"Publishes user.deleted, confirmed before the account goes [AMQP]"| events

    contentService -->|"Stores folders, units and reviews in [SQLAlchemy]"| contentDb
    contentService -->|"Asks for the next review date on each rating [HTTP/JSON]"| scheduler
    contentService -->|"Reads and deletes uploaded documents on [Filesystem]"| fileVolume
    contentService -->|"Answers the chatbot with [HTTPS/JSON]"| openai

    scheduler -->|"Loads the user's tuned scheduler from [PyMongo]"| schedulerDb

    fileService -->|"Writes uploads, converts them to PDF on [Filesystem]"| fileVolume
    fileService -->|"Records the uploaded file metadata in [HTTP/JSON]"| contentService
    fileService -->|"Enqueues one task per study-unit type on [Celery]"| queue
    fileService -->|"Extracts the source text from [HTTPS]"| sources

    queue -->|"Delivers the queued generation tasks to [Celery]"| worker
    worker -->|"Generates the flashcards, note and test with [HTTPS/JSON]"| openai
    worker -->|"Writes each finished study unit to [SQLAlchemy]"| contentDb

    events -->|"Delivers user.deleted to the durable queue of [AMQP]"| userEvents
    userEvents -->|"Deletes that learner's folders and units from [SQLAlchemy]"| contentDb
    userEvents -->|"Deletes that learner's uploaded documents on [Filesystem]"| fileVolume

