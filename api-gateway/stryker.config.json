{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "clear-text"
  ],
  "coverageAnalysis": "all",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "mutate": [
    "src/**/*.ts"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "disableTypeChecks": true,
  "vitest": {
    "related": true
  }
}
