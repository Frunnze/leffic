{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES2020"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "types": ["njs-types/ngx_http_js_module"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}
