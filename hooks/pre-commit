#!/bin/sh
set -e

. "$(dirname "$0")/_env.sh"

for declared in $declared_services $declared_node_packages; do
    if [ ! -d "$declared/src" ]; then
        echo "pre-commit: $declared is declared in hooks/_env.sh but has" >&2
        echo "pre-commit: no src directory, so nothing checks it" >&2
        exit 1
    fi
done

checks_cheapest_first="
tracked-lockfiles
secrets
file-length
feature-isolation
open-closed
dependency-inversion
definition-names
nested-definitions
class-methods
duplicate-code
dead-code
linters
unused-deps
property-tests
vulnerable-deps
security-patterns
strict-typing
api-contract
coverage
"

run_order=" $(echo $checks_cheapest_first) "

for check_directory in hooks/checks/*/; do
    check_name=$(basename "$check_directory")

    case "$run_order" in
        *" $check_name "*) ;;
        *)
            echo "pre-commit: $check_name is missing from" >&2
            echo "pre-commit: checks_cheapest_first, so it never runs" >&2
            exit 1
            ;;
    esac
done

for check_name in $checks_cheapest_first; do
    "hooks/checks/$check_name/check"
done
