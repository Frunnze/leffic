#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

require_binary "$basedpyright_binary" basedpyright

echo "pre-commit: strict typing (python and typescript)"
echo "pre-commit: type it strictly - an illegal state must fail to compile"
echo "pre-commit: never silence the checker - fix the type instead"
echo "pre-commit: follow LSP - an override must honour the base it replaces"

for package in $node_packages; do
    if [ ! -d "$repository_root/$package/node_modules" ]; then
        echo "pre-commit: $package has no node_modules -" >&2
        echo "pre-commit: run ./install.sh" >&2
        exit 1
    fi

    if ! (cd "$repository_root/$package" && npm run --silent typecheck); then
        echo "pre-commit: $package does not type-check" >&2
        exit 1
    fi
done

for service in $services; do
    (cd "$service" && "$basedpyright_binary")
done
