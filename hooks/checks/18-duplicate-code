#!/bin/sh
set -e
. "$(dirname "$0")/_env.sh"

require_binary "$pylint_binary" pylint

echo "pre-commit: duplicate code (write it once)"

for service in $services; do
    if ! git ls-files "$service/src/*.py" | xargs "$pylint_binary" \
        --disable=all --enable=duplicate-code; then
        echo "pre-commit: duplicated code in $service - reuse it," >&2
        echo "pre-commit: do not copy it" >&2
        exit 1
    fi
done
