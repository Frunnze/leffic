#!/bin/sh
set -e
. "$(dirname "$0")/_env.sh"

if [ ! -x "$(command -v gitleaks)" ]; then
    echo "pre-commit: gitleaks is not installed - run ./install.sh" >&2
    exit 1
fi

echo "pre-commit: secrets (nothing private leaves the machine)"

if ! gitleaks git --staged --no-banner --redact "$repository_root"; then
    echo "pre-commit: a secret is staged - remove it, rotate the" >&2
    echo "pre-commit: credential, and keep it in .env instead" >&2
    exit 1
fi
