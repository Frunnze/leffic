#!/bin/sh
set -e
. "$(dirname "$0")/_env.sh"

require_binary "$deptry_binary" deptry

echo "pre-commit: dependencies (declare what you import, drop what you don't)"

for service in $services; do
    if ! (cd "$service" && "$deptry_binary" src \
        --experimental-namespace-package); then
        echo "pre-commit: requirements.txt disagrees with the imports in" >&2
        echo "pre-commit: $service - delete the unused dependency, declare" >&2
        echo "pre-commit: the transitive one, or add it to [tool.deptry]" >&2
        echo "pre-commit: per_rule_ignores when the runtime needs it" >&2
        exit 1
    fi
done
