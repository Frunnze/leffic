#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

finder="$(dirname "$0")/class_method_counts.py"
typescript_finder="$(dirname "$0")/class_method_counts.js"

echo "pre-commit: class methods (one job per class)"
echo "pre-commit: follow SRP - split a class that has two reasons to change"
echo "pre-commit: follow ISP - no caller should depend on methods it ignores"
echo "pre-commit: a typescript class of statics is a module, so only its"
echo "pre-commit: instance methods count, as only they form an interface"

crowded_classes=""

if [ -n "$source_directories" ]; then
    require_binary "$python_binary" python

    crowded_classes=$(python_files_in $source_directories \
        | "$python_binary" "$finder")
fi

if [ -n "$node_source_directories" ]; then
    require_binary "$node_binary" node
    require_binary "$typescript_module" typescript

    crowded_classes="$crowded_classes
$(typescript_files_in $node_source_directories \
    | "$node_binary" "$typescript_finder" "$typescript_module")"
fi

if [ -n "$(echo "$crowded_classes" | tr -d '\n ')" ]; then
    echo "pre-commit: these classes do too much - split them:" >&2
    echo "$crowded_classes" | grep . >&2
    exit 1
fi
