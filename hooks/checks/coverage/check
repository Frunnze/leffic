#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

minimum_coverage=100

echo "pre-commit: branch coverage (min $minimum_coverage%), shuffled"
echo "pre-commit: test first - do not write a branch no test asked for"

if [ -n "$services" ]; then
    require_binary "$python_binary" python

    for service in $services; do
        (cd "$service" && "$python_binary" -m pytest tests -q \
            -p randomly \
            --cov=src \
            --cov-branch \
            --cov-report=term-missing:skip-covered \
            --cov-fail-under="$minimum_coverage")
    done
fi

if [ -n "$node_packages" ]; then
    for node_package in $node_packages; do
        require_node_modules "$node_package"

        if ! (cd "$node_package" && npm run --silent coverage); then
            echo "pre-commit: $node_package is not fully covered - test" >&2
            echo "pre-commit: every branch you wrote, or delete the" >&2
            echo "pre-commit: branch no test asked for" >&2
            exit 1
        fi
    done
fi
