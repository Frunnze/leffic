#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

maximum_file_lines=200

echo "pre-commit: file length (max $maximum_file_lines lines)"
echo "pre-commit: follow SRP - split a file that grew past one job"

source_files=$(
    git ls-files '*.py' '*.ts' '*.tsx'
    git ls-files --others --exclude-standard '*.py' '*.ts' '*.tsx'
)

overlong_files=$(echo "$source_files" | while read -r source_file; do
    [ -f "$source_file" ] || continue
    wc -l "$source_file"
done | awk -v limit="$maximum_file_lines" \
    '$1 > limit {print $2 " (" $1 " lines)"}')

if [ -n "$overlong_files" ]; then
    echo "pre-commit: over $maximum_file_lines lines:" >&2
    echo "$overlong_files" >&2
    exit 1
fi
