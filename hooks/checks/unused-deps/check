#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

echo "pre-commit: dependencies (declare what you import, drop what you don't)"
echo "pre-commit: be explicit - declare every dependency you import"
echo "pre-commit: follow YAGNI - drop a dependency nothing imports"

if [ -n "$services" ]; then
    require_binary "$deptry_binary" deptry

    for service in $services; do
        if ! (cd "$service" && "$deptry_binary" src \
            --experimental-namespace-package); then
            echo "pre-commit: requirements.txt disagrees with the" >&2
            echo "pre-commit: imports in $service - delete the unused" >&2
            echo "pre-commit: dependency, declare the transitive one," >&2
            echo "pre-commit: or add it to [tool.deptry]" >&2
            echo "pre-commit: per_rule_ignores when the runtime needs it" >&2
            exit 1
        fi
    done
fi

if [ -n "$node_packages" ]; then
    require_binary "$knip_binary" knip

    for node_package in $node_packages; do
        require_node_modules "$node_package"

        if ! (cd "$node_package" && "$knip_binary" \
            --include dependencies,unlisted,binaries,unresolved); then
            echo "pre-commit: package.json disagrees with the imports in" >&2
            echo "pre-commit: $node_package - delete the unused dependency," >&2
            echo "pre-commit: declare the imported one, or add it to" >&2
            echo "pre-commit: ignoreDependencies in $node_package/knip.json" >&2
            echo "pre-commit: when the runtime needs it" >&2
            exit 1
        fi
    done
fi
