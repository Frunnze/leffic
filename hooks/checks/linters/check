#!/bin/sh
set -e
. "$(dirname "$0")/../../_env.sh"

echo "pre-commit: linters (ruff+pylint for python, eslint for typescript)"
echo "pre-commit: write for the reader - code is read far more than written"
echo "pre-commit: avoid astonishment - behave as the call site expects"

if [ -n "$services" ]; then
    "$(dirname "$0")/ruff/check"
    "$(dirname "$0")/pylint/check"
fi

if [ -n "$node_packages" ]; then
    require_binary "$eslint_binary" eslint

    for node_package in $node_packages; do
        require_node_modules "$node_package"

        if ! (cd "$node_package" \
            && "$eslint_binary" src --max-warnings 0); then
            echo "pre-commit: eslint rejected $node_package" >&2
            exit 1
        fi
    done
fi
